# Environment variables for FictSelf Backend
# Copy this file to .env and customize for your environment.
# DO NOT commit your actual .env file with real credentials!

# --- Application Configuration ---
PROJECT_NAME="FictSelf API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- Security / JWT ---
# CRITICAL: Generate a strong random key for production!
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace_this_with_a_secure_random_secret_key_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# --- Database Configuration ---
# Option A: Local PostgreSQL instance
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="fictself"
POSTGRES_PORT=5432

# Option B: Direct / Pooler Database Connection String (e.g., Supabase / Neon / RDS)
# If set, DATABASE_URL overrides the individual POSTGRES_* settings above.
# Example: postgresql://postgres.project_ref:password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=""

# --- LLM Provider Settings (Groq) ---
# FictSelf uses Groq for fast inference on character companions and memory extraction.
# Required for AI chat and memory extraction features.
# Get an API key at https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"
LLM_PROVIDER="groq"

# Primary character LLM model (Groq):
# Options: "openai/gpt-oss-120b", "llama-3.3-70b-versatile"
LLM_MODEL="openai/gpt-oss-120b"

# --- Story Memory RAG Settings ---
# Embedding model runs locally on CPU via sentence-transformers (zero external API cost)
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
CHROMA_PERSIST_DIR="./chroma_db"
RETRIEVAL_TOP_K=5

# --- Email / OTP Verification ---
# Required for user registration OTP verification.
# For local development with Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_email_app_password"
EMAILS_FROM_EMAIL="noreply@fictself.example.com"

